{
    "manifest_version": 3,

    "name": "Colourly — Colour Picker",

    "version": "1.0.0",

    "description": "Pick colours from any webpage and instantly get HEX, RGB, HSL and CMYK values.",

    "permissions": [
        "sidePanel"
    ],

    "action": {
        "default_title": "Colourly",
        "default_icon": {
            "128": "logo.png"
        }
    },

    "side_panel": {
        "default_path": "sidepanel.html"
    },

    "icons": {
        "128": "logo.png"
    }
}