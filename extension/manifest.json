{
    "manifest_version": 3,

    "name": "Colourly — Colour Picker",

    "version": "1.0.0",

    "description": "Pick any colour from a webpage and instantly get its HEX, RGB, HSL, and CMYK values.",

    "permissions": [
        "sidePanel",
        "tabCapture",
        "offscreen",
        "activeTab"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "action": {
        "default_title": "Colourly"
    },

    "side_panel": {
        "default_path": "sidepanel.html"
    },

    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ],

    "icons": {
        "128": "icon.png"
    }
}